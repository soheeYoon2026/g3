[Unit]
Description=AOX G3 shadow challenger inference API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/g3
Environment=G3_MODEL_PATH=models/registry/challenger.pt
Environment=G3_COEFFICIENT_EXPERT=g2_su2_clean
Environment=G3_API_TOKEN_FILE=/home/ubuntu/g3/.service-token
Environment=G3_SHADOW_SAMPLE_RATE=0
ExecStart=/home/ubuntu/venv_g3/bin/uvicorn aox_g3.service:app --host 127.0.0.1 --port 8004
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

