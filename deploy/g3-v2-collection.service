[Unit]
Description=AOX G3-v2 incremental S3 collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/g3-v2
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/venv_g3/bin/python scripts/run_scheduled_collection.py --root /home/ubuntu/g3-v2 --minimum-free-gb 10
Nice=10

