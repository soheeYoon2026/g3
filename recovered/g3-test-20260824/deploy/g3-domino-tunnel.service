[Unit]
Description=AOX G3 DoMINO authenticated Cloudflare tunnel
After=network-online.target g3-domino-inference.service
Wants=network-online.target
Requires=g3-domino-inference.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/g3-v2
ExecStart=/home/ubuntu/venv_g3/bin/python /home/ubuntu/g3-v2/scripts/run_service_tunnel.py --target http://127.0.0.1:8005 --token-file /home/ubuntu/g3/.service-token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
